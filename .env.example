# WeMai 基础连接
WEFLOW_API_URL=http://127.0.0.1:5031
WEFLOW_API_TOKEN=
MAIBOT_API_URL=ws://127.0.0.1:8000/ws
MAIBOT_DATA_DIR=
PLATFORM_ID=wx
WEFLOW_DISPATCH_WORKERS=8
INBOUND_ROUTER_CONCURRENCY=8

# 微信与文件
WEMAI_BOT_NICKNAME=
IMAGE_SAVE_DIR=WeMai媒体
# 普通微信文件下载/发送上限（字节，默认 200 MiB）
FILE_MAX_BYTES=209715200
# 可信本地插件文件交付根目录；留空时禁用 file:// 出站
LOCAL_FILE_DELIVERY_ROOT=
LOG_LEVEL=INFO

# 配置中心。对外监听 0.0.0.0 时必须设置访问密码。
WEBUI_HOST=127.0.0.1
WEBUI_PORT=8888
WEBUI_PASSWORD=

# OCR 高级扩展。全部关闭时不启动 SDK、不加载 OCR。
OPTIONAL_CONTACTS_ENABLED=false
OPTIONAL_GROUPS_ENABLED=false
# 微信更新弹窗：识别后等待 5 秒，自动点击“忽略本次更新”
WEMAI_AUTO_DISMISS_UPDATE=true
WEMAI_UPDATE_DISMISS_DELAY=5
WEMAI_UPDATE_DIALOG_SCAN_INTERVAL=259200
